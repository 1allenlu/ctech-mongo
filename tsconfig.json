{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["shared/**/*.ts", "db/**/*.ts", "tests/**/*.ts", "seed/**/*.ts", "scripts/**/*.ts"]
}
