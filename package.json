{
  "name": "ctech-mongo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "demo": "tsx scripts/demo.ts",
    "test": "tsx --test tests/*.test.ts agent/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "demo:read": "tsx scripts/demo-read.ts",
    "demo:live": "tsx scripts/demo-live.ts",
    "harness:diff": "tsx scripts/harness-diff.ts",
    "agent:demo": "tsx --env-file-if-exists=.env agent/demo.ts",
    "agent:demo:live": "tsx --env-file-if-exists=.env agent/demo.ts --live",
    "demo:harness": "tsx scripts/showcase.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "mongodb": "^7.6.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
